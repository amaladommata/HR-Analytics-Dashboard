# Google Sheets live-sync (see README.md "Live data from Google Sheets" for full setup steps)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Format: <spreadsheetId>#<tabName>  (the spreadsheetId is the long id in the sheet's URL)
SHEET_HEADCOUNT=1AbCDefGhIjKlMnOpQrStUvWxYz#Headcount
SHEET_EXITS_YTD=1AbCDefGhIjKlMnOpQrStUvWxYz#Exits YTD
SHEET_NOTICE_PERIOD=1AbCDefGhIjKlMnOpQrStUvWxYz#Notice Period
SHEET_GLOBAL_EXITS=1AbCDefGhIjKlMnOpQrStUvWxYz#Global Exits
